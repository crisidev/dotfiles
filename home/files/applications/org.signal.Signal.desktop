[Desktop Entry]
Name=Signal
Comment=Private messaging from your desktop
# --ozone-platform=wayland: run Signal natively (see the flatpak override).
# Current Electron ignores ELECTRON_OZONE_PLATFORM_HINT.
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=signal-desktop --file-forwarding org.signal.Signal --ozone-platform=wayland @@u %U @@
Terminal=false
Type=Application
Icon=org.signal.Signal
StartupWMClass=Signal
MimeType=x-scheme-handler/sgnl;x-scheme-handler/signalcaptcha;
Categories=Network;InstantMessaging;Chat;
X-Flatpak=org.signal.Signal
