[Desktop Entry]
Name=Ferdium
Comment=Desktop app bringing all your messaging services into one installable
# --ozone-platform=wayland: run Ferdium natively (see the flatpak override).
# Current Electron ignores ELECTRON_OZONE_PLATFORM_HINT.
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=ferdium --file-forwarding org.ferdium.Ferdium --ozone-platform=wayland @@u %U @@
Terminal=false
Type=Application
Icon=org.ferdium.Ferdium
StartupWMClass=Ferdium
MimeType=x-scheme-handler/ferdium;
Categories=Network;InstantMessaging;
X-Flatpak=org.ferdium.Ferdium
