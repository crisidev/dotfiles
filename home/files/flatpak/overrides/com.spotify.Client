# Run Spotify on native Wayland: under fractional scaling XWayland gets
# bitmap-upscaled → grainy text. Spotify is CEF, not Electron, so
# ELECTRON_OZONE_PLATFORM_HINT does nothing; the wayland socket is granted here
# and `--ozone-platform-hint=auto` is passed at launch instead (see
# applications/com.spotify.Client.desktop).
[Context]
sockets=wayland;
