# Signal runs on native Wayland. Its Electron CSD frame is built from the
# GTK theme, which only lines up with pop-shell's border because flatpak.nix
# installs gtk.css (gtkCsdReset) as a real file the sandbox can read.
# Current Electron ignores ELECTRON_OZONE_PLATFORM_HINT, so the launcher
# (files/applications) passes --ozone-platform=wayland explicitly.
[Context]
# nixGL exports these GL driver paths into the session; flatpak forwards them
# into the sandbox where the /nix/store paths don't exist, so Mesa fails to
# load its DRI/GBM driver (EGL/GLX). Drop them so the runtime's own
# Mesa is used.
unset-environment=LIBGL_DRIVERS_PATH;GBM_BACKENDS_PATH;LIBVA_DRIVERS_PATH;
