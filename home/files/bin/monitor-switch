#!/usr/bin/env bash
# Set text scaling and the kitty font size for the attached monitor:
# BenQ PD3200U at home, the built-in panel otherwise. Runs once at login, then
# waits for Mutter's MonitorsChanged D-Bus signal instead of polling.
# `monitor-switch now` applies the settings once and exits.
export PATH=$PATH:/usr/bin:$HOME/.bin

# Last applied configuration, so repeated signals don't re-apply it.
prev=""

apply() {
    local force=$1 monitor_info current scale kitty_font

    # Decode the EDID of every connector, keeping the product names.
    monitor_info=$(for edid in /sys/class/drm/*/edid; do
        edid-decode "$edid" 2>/dev/null | grep "Display Product Name"
    done)

    if echo "$monitor_info" | grep -q "BenQ PD3200U"; then
        current="home"
        scale="1.00"
        kitty_font="11"
    else
        current="builtin"
        scale="1.3"
        kitty_font="14"
    fi

    [ "$force" != "force" ] && [ "$current" = "$prev" ] && return

    echo "Detected ${current} monitor, setting text scaling to ${scale}"
    gsettings set org.gnome.desktop.interface text-scaling-factor "$scale"
    # kitty.conf is nix-managed (read-only) and globincludes this mutable
    # file; write it fresh (it may not exist yet) and SIGUSR1 → reload.
    echo "font_size ${kitty_font}" >~/.config/kitty/font_size.conf
    pkill -USR1 -x kitty || true
    # Windows follow their pop-shell workspace-rules on monitor changes.
    prev="$current"
}

if [ "$1" == "now" ]; then
    apply force
    exit 0
fi

apply

# Mutter emits MonitorsChanged on every display change (several per hotplug),
# next to unrelated property changes (backlight) that are filtered out. Wait
# for a quiet second before re-checking, then apply only if the setup changed.
# If the monitor exits (the shell restarted), check again and reconnect.
while true; do
    # Process substitution keeps the loop (and $prev) in this shell.
    while read -r line; do
        [[ "$line" == *".MonitorsChanged "* ]] || continue
        while read -r -t 1 _; do :; done
        apply
    done < <(gdbus monitor --session --dest org.gnome.Mutter.DisplayConfig \
        --object-path /org/gnome/Mutter/DisplayConfig 2>/dev/null)
    sleep 2
    apply
done
