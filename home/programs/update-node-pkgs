#!/usr/bin/env bash
set -euo pipefail

NODE_NIX="$(dirname "$0")/node.nix"

get_latest_tag() {
  local owner=$1 repo=$2
  local tag
  tag=$(curl -sf "https://api.github.com/repos/$owner/$repo/releases/latest" 2>/dev/null | jq -r '.tag_name // empty') || true
  if [ -z "$tag" ]; then
    tag=$(curl -sf "https://api.github.com/repos/$owner/$repo/tags" | jq -r '.[0].name')
  fi
  echo "$tag"
}

update_github_pkg() {
  local owner=$1 repo=$2 current_rev=$3 nix_file=$4 anchor=$5
  local tag version src_out src_hash src_path lock npm_deps_hash

  tag=$(get_latest_tag "$owner" "$repo")

  if [ "$tag" = "$current_rev" ]; then
    echo "  $owner/$repo: already at $tag"
    return
  fi

  echo "  $owner/$repo: $current_rev -> $tag"

  # --print-path emits the hash on line 1 and the unpacked store path on line 2.
  src_out=$(nix-prefetch-url --unpack --print-path "https://github.com/$owner/$repo/archive/refs/tags/$tag.tar.gz" 2>/dev/null)
  src_hash=$(echo "$src_out" | head -1)
  src_path=$(echo "$src_out" | tail -1)
  src_hash=$(nix hash convert --hash-algo sha256 --to sri "$src_hash")

  # Range is anchored on the derivation binding (e.g. `claude-powerline =
  # pkgs.buildNpmPackage`) so it covers the `version =` line, which sits above
  # `repo =` in the block and would otherwise be left stale.
  version="${tag#v}"
  sed -i "/$anchor = pkgs.buildNpmPackage/,/npmDepsHash/ {
    s|version = \"[^\"]*\";|version = \"$version\";|
    s|rev = \"[^\"]*\";|rev = \"$tag\";|
    s|hash = \"sha256-[^\"]*\";|hash = \"$src_hash\";|
  }" "$nix_file"

  # Compute npmDepsHash directly from the lockfile in the user environment.
  # buildNpmPackage's deps FOD is built by the nix daemon as the _nixbld user,
  # which can't validate npmjs.org's corpnet-MITM'd cert (the corp CA lives in
  # the login keychain, not _nixbld's), so the old build-and-scrape-`got:`
  # approach never produced a hash behind the proxy. prefetch-npm-deps run here
  # uses our keychain trust and works.
  echo "  Computing npmDepsHash..."
  lock="$src_path/package-lock.json"
  [ -f "$lock" ] || lock="$src_path/npm-shrinkwrap.json"
  npm_deps_hash=$(nix run nixpkgs#prefetch-npm-deps -- "$lock" 2>/dev/null | tail -1) || true

  if [ -n "$npm_deps_hash" ]; then
    sed -i "/$anchor = pkgs.buildNpmPackage/,/npmDepsHash/ {
      s|npmDepsHash = \"sha256-[^\"]*\";|npmDepsHash = \"$npm_deps_hash\";|
    }" "$nix_file"
    echo "  Done ($npm_deps_hash)."
  else
    echo "  WARNING: could not compute npmDepsHash for $owner/$repo (lockfile: $lock)."
  fi
}

update_npm_tarball() {
  local name=$1 current_version=$2 nix_file=$3
  local version src_hash

  version=$(curl -sf "https://registry.npmjs.org/$name/latest" | jq -r '.version')

  if [ "$version" = "$current_version" ]; then
    echo "  npm/$name: already at $version"
    return
  fi

  echo "  npm/$name: $current_version -> $version"

  # The url interpolates ${version}, so only version and hash need rewriting.
  src_hash=$(nix-prefetch-url "https://registry.npmjs.org/$name/-/$name-$version.tgz" 2>/dev/null)
  src_hash=$(nix hash convert --hash-algo sha256 --to sri "$src_hash")

  sed -i "/pname = \"$name\"/,/installPhase/ {
    s|version = \"[^\"]*\";|version = \"$version\";|
    s|hash = \"sha256-[^\"]*\";|hash = \"$src_hash\";|
  }" "$nix_file"
  echo "  Done."
}

echo "Updating node packages..."

neovim_rev=$(grep -A2 'repo = "node-client"' "$NODE_NIX" | grep -oP 'rev = "\K[^"]+')
powerline_rev=$(grep -A2 'repo = "claude-powerline"' "$NODE_NIX" | grep -oP 'rev = "\K[^"]+')
moremaid_rev=$(grep -A2 'repo = "moremaid"' "$NODE_NIX" | grep -oP 'rev = "\K[^"]+')
cc_lens_version=$(grep -A1 'pname = "cc-lens"' "$NODE_NIX" | grep -oP 'version = "\K[^"]+')

update_github_pkg "neovim" "node-client" "$neovim_rev" "$NODE_NIX" "neovim-node-client"
update_github_pkg "Owloops" "claude-powerline" "$powerline_rev" "$NODE_NIX" "claude-powerline"
update_github_pkg "thieso2" "moremaid" "$moremaid_rev" "$NODE_NIX" "moremaid"
update_npm_tarball "cc-lens" "$cc_lens_version" "$NODE_NIX"

echo "All node packages up to date."
