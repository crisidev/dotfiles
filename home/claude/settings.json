{
  "permissions": {
    "allow": [
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(helm list *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.nix-profile/bin/claude-powerline",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true
  },
  "extraKnownMarketplaces": {
    "fullstack-dev-skills": {
      "source": {
        "source": "github",
        "repo": "jeffallan/claude-skills"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "default",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(kubectl delete:*) in namespace argocd, database, or kube-system — protected-scope manual-sync charts per CLAUDE.md",
      "Bash(./hack/provision.sh) — CLAUDE.md explicitly flags this as reprovisioning all nodes"
    ],
    "environment": []
  },
  "diffSidebarOpen": false
}
